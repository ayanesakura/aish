def write_private(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path) or ".", mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


# 基于 Chromium 的浏览器：(显示名, Application Support 下的目录, 钥匙串条目)
BROWSERS = [
    ("Chrome", "Google/Chrome", "Chrome Safe Storage"),
    ("Chrome Beta", "Google/Chrome Beta", "Chrome Safe Storage"),
    ("Edge", "Microsoft Edge", "Microsoft Edge Safe Storage"),
    ("Brave", "BraveSoftware/Brave-Browser", "Brave Safe Storage"),
    ("Arc", "Arc/User Data", "Arc Safe Storage"),
    ("Chromium", "Chromium", "Chromium Safe Storage"),
]
_KEYCHAIN_CACHE: dict[str, str] = {}


def _keychain_password(service: str) -> str:
    if service not in _KEYCHAIN_CACHE:
        note(f"正在从钥匙串读取「{service}」以解密浏览器 cookie；如弹出授权窗口，请点「始终允许」。")
        try:
            r = subprocess.run(["security", "find-generic-password", "-w", "-s", service],
                               capture_output=True, text=True, timeout=180)
        except (OSError, subprocess.TimeoutExpired) as e:
            raise AishError(f"读取钥匙串失败：{type(e).__name__}")
        if r.returncode != 0:
            raise AishError(f"读取钥匙串「{service}」失败（可能点了拒绝），无法解密浏览器 cookie")
        _KEYCHAIN_CACHE[service] = r.stdout.strip()
    return _KEYCHAIN_CACHE[service]


def _chromium_decrypt(enc: bytes, password: str, db_version: int, host_key: str) -> str:
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

    if enc[:3] not in (b"v10", b"v11"):
        raise ValueError("unsupported cookie encryption")
    key = hashlib.pbkdf2_hmac("sha1", password.encode(), b"saltysalt", 1003, 16)
    d = Cipher(algorithms.AES(key), modes.CBC(b" " * 16)).decryptor()
    pt = d.update(enc[3:]) + d.finalize()
    pt = pt[: -pt[-1]]
    # Chrome 130+（cookie DB version >= 24）在明文前加了 SHA256(host_key)
    if db_version >= 24 and pt[:32] == hashlib.sha256(host_key.encode()).digest():
        pt = pt[32:]
    return pt.decode("utf-8")


def read_browser_cookie(host: str, name: str = "ais_token") -> tuple[str, str, float | None] | None:
    """从本机 Chromium 系浏览器读取 cookie，返回 (值, 来源描述, 过期时间)；找不到返回 None。"""
    if sys.platform != "darwin":
        return None
    import glob
    import sqlite3

    root = os.path.expanduser("~/Library/Application Support")
    cands = []
    for label, sub, service in BROWSERS:
        base = glob.escape(os.path.join(root, sub))
        for db in glob.glob(os.path.join(base, "*", "Cookies")) + glob.glob(os.path.join(base, "*", "Network", "Cookies")):
            prof_dir = os.path.dirname(db)
            if os.path.basename(prof_dir) == "Network":
                prof_dir = os.path.dirname(prof_dir)
            try:
                con = sqlite3.connect("file:" + urllib.parse.quote(db) + "?mode=ro&immutable=1", uri=True)
                try:
                    row = con.execute("select value from meta where key='version'").fetchone()
                    ver = int(row[0]) if row else 0
                    rows = con.execute("select host_key, value, encrypted_value, expires_utc, last_access_utc "
                                       "from cookies where name=?", (name,)).fetchall()
                finally:
                    con.close()
            except Exception as e:  # DB 结构不同 / 读不了就跳过
                log(f"跳过 {db}: {type(e).__name__}")
                continue
            for hk, val, enc, exp, acc in rows:
                h = hk.lstrip(".")
                if not (host == h or host.endswith("." + h)):
                    continue
                exp_unix = exp / 1e6 - 11644473600 if exp else None
                if exp_unix and exp_unix < time.time():
                    continue
                cands.append({"acc": acc or 0, "where": f"{label}（{os.path.basename(prof_dir)}）", "service": service,
                              "ver": ver, "hk": hk, "val": val, "enc": enc, "exp": exp_unix})
    cands.sort(key=lambda c: c["acc"], reverse=True)  # 最近使用的优先
    for c in cands:
        try:
            v = c["val"] or _chromium_decrypt(c["enc"], _keychain_password(c["service"]), c["ver"], c["hk"])
        except AishError:
            raise
        except Exception as e:
            log(f"解密 {c['where']} 的 cookie 失败: {type(e).__name__}")
            continue
        v = v.strip()
        if v and re.fullmatch(r"[\x21-\x7e]+", v) and ";" not in v:
            return v, c["where"], c["exp"]
    return None


class CookieJar:
    """cookie 来源：先读 cookie 文件；文件缺失或被服务端拒绝时，自动从浏览器读取并写回文件。"""

    BROWSER_MIN_INTERVAL = 60.0

    def __init__(self, base: str, allow_browser: bool) -> None:
        self.base = base
        self.host = urllib.parse.urlsplit(base).hostname or ""
        self.allow_browser = allow_browser
        self.path = token_file_path()
        self.value: str | None = None
        self._last_browser = 0.0

    def hint(self) -> str:
        auto = "aish 会自动读取 Chrome 里的 cookie，" if self.allow_browser else ""
        return (f"请在浏览器里打开并登录 AI Studio（{self.base}），{auto}然后重试；"
                f"或手动把 Cookie ais_token 的值写入 {self.path}（chmod 600）。")

    def _read_file(self) -> str | None:
        try:
            with open(self.path, "r", encoding="utf-8") as f:
                v = f.read().strip()
        except FileNotFoundError:
            return None
        except OSError as e:
            raise AishError(f"无法读取 cookie 文件 {self.path}：{e.strerror}")
        if v.lower().startswith("ais_token="):
            v = v.split("=", 1)[1].strip()
        REDACT.add(v)
        if not v or any(c in v for c in "\r\n; \t"):
            raise AishError(f"cookie 文件 {self.path} 内容格式不对（应只有一行 ais_token 的值）。" + self.hint())
        return v

    def from_browser(self, force: bool = False) -> str | None:
        if not self.allow_browser:
            return None
        if not force and time.monotonic() - self._last_browser < self.BROWSER_MIN_INTERVAL:
            return None
        self._last_browser = time.monotonic()
        got = read_browser_cookie(self.host)
        if not got:
            log("浏览器里没有找到可用的 ais_token")
            return None
        v, where, exp = got
        REDACT.add(v)
        if v != self.value:
            write_private(self.path, v + "\n")
            note(f"已从 {where} 读取 ais_token 并写入 {self.path}（cookie 有效期至 {fmt_time(exp)}）")
        self.value = v
        return v

    def get(self) -> str:
        if self.value:
            return self.value
        self.value = self._read_file() or self.from_browser(force=True)
        if not self.value:
            raise AishError(f"找不到 cookie：{self.path} 不存在，浏览器里也没有。" + self.hint())
        return self.value

    def refresh(self) -> bool:
        """当前 cookie 被拒绝时调用：文件被别人更新过就用文件，否则从浏览器读。拿到不同的新值返回 True。"""
        old = self.value
        v = self._read_file()
        if v and v != old:
            self.value = v
            return True
        v = self.from_browser()
        return bool(v and v != old)


# =========================================================================== 目标 / 机器名

class Target:
    def __init__(self, base: str, project: str, experiment: str, run: str, pod: str, container: str):
        self.base, self.project, self.experiment = base, project, experiment
        self.run, self.pod, self.container = run, pod, container


def target_from(url: str | None, overrides: dict | None = None) -> Target:
    vals = {"project": None, "experiment": None, "run": None, "pod": None, "container": None}
    base = None
    if url:
        u = urllib.parse.urlsplit(url)
        if u.scheme not in ("http", "https") or not u.netloc:
            raise AishError("URL 无法解析，应形如 https://ais.mlp.shopee.io/projects/.../web-shell?...")
        base = f"{u.scheme}://{u.netloc}"
        q = urllib.parse.parse_qs(u.query)
        keymap = {"projectId": "project", "experimentId": "experiment", "runId": "run",
                  "podName": "pod", "containerName": "container", "instance": "pod", "container": "container"}
        for k, dst in keymap.items():
            if q.get(k) and not vals[dst]:
                vals[dst] = q[k][0]
    for k, v in (overrides or {}).items():
        if v:
            vals[k] = v
    vals["container"] = vals["container"] or "main"
    missing = [k for k, v in vals.items() if not v]
    if missing:
        raise AishError("缺少参数：" + ", ".join("--" + m for m in missing) + "（可以直接给 web-shell 页面 URL）")
    base = (os.environ.get("AIS_BASE_URL") or base or DEFAULT_BASE).rstrip("/")
    return Target(base, **vals)  # type: ignore[arg-type]


def hosts_path() -> str:
    return config_path("AISH_HOSTS_FILE", DEFAULT_HOSTS_FILE)


def load_hosts() -> dict:
    try:
        with open(hosts_path(), encoding="utf-8") as f:
            data = json.load(f)
        return data.get("hosts", {}) if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        raise AishError(f"机器列表 {hosts_path()} 读取失败：{e}")


def save_hosts(hosts: dict) -> None:
    write_private(hosts_path(), json.dumps({"hosts": hosts}, ensure_ascii=False, indent=2) + "\n")


# =========================================================================== HTTP

def http_get(url: str, cookie: str, timeout: float = 15.0) -> tuple[int, bytes]:
    req = urllib.request.Request(url, headers={
        "Cookie": f"ais_token={cookie}", "Accept": "application/json, */*", "User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, r.read()
    except urllib.error.HTTPError as e:
        try:
            body = e.read()
        except Exception:
            body = b""
        return e.code, body
    except urllib.error.URLError as e:
        raise AishError(f"网络错误：{e.reason}")
    except (TimeoutError, OSError) as e:
        raise AishError(f"网络错误：{e}")


class ShellInfo:
    def __init__(self, term_url: str):
        self.term_url = term_url
        u = urllib.parse.urlsplit(term_url)
        q = urllib.parse.parse_qs(u.query)
        self.origin = f"{u.scheme}://{u.netloc}"
        self.session = (q.get("session") or [""])[0]
        self.cluster = (q.get("cluster") or [""])[0]
        self.token = (q.get("token") or [""])[0]
        REDACT.add(self.token)
        if not self.session:
            raise AishError("换到的 webshell 地址里没有 session 参数，协议可能已变化。")

    def ws_url(self, cols: int, rows: int) -> str:
        u = urllib.parse.urlsplit(self.term_url)
        scheme = {"https": "wss", "http": "ws"}.get(u.scheme)
        if not scheme or not u.path.endswith("/webshell/terminal"):
            raise AishError("换到的 webshell 地址格式不认识，协议可能已变化。")
        path = u.path[: -len("/webshell/terminal")] + "/webshell/opsws"
        query = u.query + f"&cols={cols}&rows={rows}"  # 查询串原样保留
        return urllib.parse.urlunsplit((scheme, u.netloc, path, query, ""))

    def token_exp(self) -> float | None:
        try:
            seg = self.token.split(".")[1]
            seg += "=" * (-len(seg) % 4)
            exp = json.loads(base64.urlsafe_b64decode(seg)).get("exp")
            return float(exp) if exp else None
        except Exception:
            return None


def _fetch_shell_once(t: Target, cookie: str, jar: CookieJar) -> ShellInfo:
    q = urllib.parse.urlencode({"instance": t.pod, "container": t.container, "ch": "ais-web"})
    p = lambda s: urllib.parse.quote(s, safe="")
    url = (f"{t.base}/api/experiment/v1/projects/{p(t.project)}/experiments/{p(t.experiment)}"
           f"/runs/{p(t.run)}/webshellUrl?{q}")
    status, body = http_get(url, cookie)
    try:
        j = json.loads(body.decode("utf-8", "replace"))
    except ValueError:
        j = None
    if status != 200 or not isinstance(j, dict) or j.get("code") != 200:
        code = j.get("code") if isinstance(j, dict) else None
        msg = (j.get("msg") if isinstance(j, dict) else None) or ""
        detail = f"HTTP {status}" + (f"，code={code}" if code is not None else "") \
            + (f"，msg={str(msg)[:200]}" if msg else "") + ("" if isinstance(j, dict) else "，返回的不是 JSON")
        raise AishError(f"换取 WebShell 令牌失败（{detail}）。cookie 可能已失效或无权访问该 pod。" + jar.hint(),
                        auth=True)
    try:
        term_url = j["data"]["url"]
    except (KeyError, TypeError):
        raise AishError("换令牌返回里没有 data.url，协议可能已变化。")
    info = ShellInfo(term_url)
    log(f"terminal url: {term_url}")
    exp = info.token_exp()
    if exp:
        log(f"session={info.session} token 过期时间 {fmt_time(exp)}（约 {int((exp - time.time()) / 60)} 分钟后）")
    return info


def fetch_shell(t: Target, jar: CookieJar) -> ShellInfo:
    try:
        return _fetch_shell_once(t, jar.get(), jar)
    except AishError as e:
        if e.auth and jar.refresh():
            return _fetch_shell_once(t, jar.get(), jar)
        raise


def do_resize(info: ShellInfo, cookie: str, cols: int, rows: int) -> None:
    q = urllib.parse.urlencode({"cols": cols, "rows": rows, "session": info.session, "cluster": info.cluster})
    status, body = http_get(f"{info.origin}/api/webshell/v1/webshell/opsresize?{q}", cookie, timeout=10)
    log(f"opsresize {cols}x{rows} -> HTTP {status} {body[:120].decode('utf-8', 'replace')}")


# =========================================================================== WebSocket

async def _open_ws_once(info: ShellInfo, cookie: str, cols: int, rows: int, jar: CookieJar):
    from websockets.asyncio.client import connect
    from websockets.exceptions import InvalidHandshake, InvalidStatus

    url = info.ws_url(cols, rows)
    log(f"connect {url}")
    try:
        return await connect(url, additional_headers={"Cookie": f"ais_token={cookie}"},
                             user_agent_header=UA, max_size=None, ping_interval=None,
                             open_timeout=20, close_timeout=3)
    except InvalidStatus as e:
        st = e.response.status_code
        if st in (401, 403):
            raise AishError(f"WebSocket 握手失败：HTTP {st}。cookie 可能已失效。" + jar.hint(), auth=True)
        raise AishError(f"WebSocket 握手失败：HTTP {st}。")
    except (OSError, InvalidHandshake, asyncio.TimeoutError) as e:
        raise AishError(f"WebSocket 连接失败：{type(e).__name__}: {e}")


async def open_ws(info: ShellInfo, jar: CookieJar, cols: int, rows: int):
    try:
        return await _open_ws_once(info, jar.get(), cols, rows, jar)
    except AishError as e:
        if e.auth and await asyncio.to_thread(jar.refresh):
            return await _open_ws_once(info, jar.get(), cols, rows, jar)
        raise


async def connect_shell(t: Target, jar: CookieJar, cols: int, rows: int):
    info = await asyncio.to_thread(fetch_shell, t, jar)
    ws = await open_ws(info, jar, cols, rows)
    return info, ws


def close_desc(ws) -> tuple[int | None, str]:
    return getattr(ws, "close_code", None), getattr(ws, "close_reason", None) or ""


async def heartbeat(ws) -> None:
    from websockets.exceptions import ConnectionClosed
    try:
        await asyncio.sleep(HEARTBEAT_FIRST)
        while True:
            await ws.send("")
            log("heartbeat")
            await asyncio.sleep(HEARTBEAT_INTERVAL)
    except ConnectionClosed:
        pass


async def liveness(ws) -> str:
    """网关响应 ping 时定期探测，探测失败返回原因；不响应 ping 则永远挂起（不做探测）。"""
    from websockets.exceptions import ConnectionClosed
    try:
        t0 = time.monotonic()
        await asyncio.wait_for(await ws.ping(), PING_TIMEOUT)
        log(f"网关响应 ping（{(time.monotonic() - t0) * 1000:.0f}ms），启用断线探测")
    except asyncio.TimeoutError:
        log("网关不响应 ping，不做 ping 探测")
        await asyncio.Future()
    except ConnectionClosed:
        await asyncio.Future()
    while True:
        await asyncio.sleep(PING_INTERVAL)
        try:
            await asyncio.wait_for(await ws.ping(), PING_TIMEOUT)
        except asyncio.TimeoutError:
            return f"{PING_TIMEOUT:g}s 内没有收到心跳回应（网络可能已断开）"
        except ConnectionClosed:
            await asyncio.Future()


def abort_ws(ws) -> None:
    tr = getattr(ws, "transport", None)
    if tr is not None:
        tr.abort()


def as_bytes(m: str | bytes) -> bytes:
    return m if isinstance(m, bytes) else m.encode("utf-8")


def write_all(fd: int, data: bytes) -> None:
    mv = memoryview(data)
    while mv:
        try:
            n = os.write(fd, mv)
        except BlockingIOError:
            time.sleep(0.005)
            continue
        mv = mv[n:]


# =========================================================================== 交互：辅助

class EscapeFilter:
    """行首 ~ 转义：~. 断开，~~ 发送 ~，~? 帮助，其它原样发送。"""

    def __init__(self) -> None:
        self.at_bol = True
        self.pending = False

    def feed(self, data: bytes) -> tuple[bytes, str | None]:
        out = bytearray()
        for b in data:
            if self.pending:
                self.pending = False
                if b == ord("."):
                    return bytes(out), "disconnect"
                if b == ord("~"):
                    out.append(b)
                    self.at_bol = False
                    continue
                if b == ord("?"):
                    note("转义序列：~. 断开连接   ~~ 发送 ~   ~? 本帮助（仅在行首有效）")
                    continue
                out.append(ord("~"))
            if self.at_bol and b == ord("~"):
                self.pending = True
                continue
            out.append(b)
            self.at_bol = b in (13, 10)
        return bytes(out), None


ANSI_RE = re.compile(rb"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\\\)|\x1b[()][0-9A-Za-z]|\x1b[=>]")


class ExitWatcher:
    """（普通 shell 模式）实测：远端 shell 退出后网关不会关闭 WebSocket。
    识别「用户输入 exit/logout（或空行 ^D）回车，随后输出以 exit/logout 结尾，且 QUIET 秒内没有新输出」。"""

    QUIET = 1.5

    def __init__(self) -> None:
        self.line = bytearray()
        self.dirty = False
        self.armed_at: float | None = None
        self.out = bytearray()

    def _arm(self, cond: bool) -> None:
        self.armed_at = time.monotonic() if cond else None
        self.out.clear()

    def on_input(self, data: bytes) -> None:
        self.armed_at = None
        for b in data:
            if b in (13, 10):
                cmd = self.line.decode("utf-8", "replace").strip()
                self._arm(not self.dirty and re.fullmatch(r"(exit|logout)(\s+\d+)?", cmd) is not None)
                self.line.clear()
                self.dirty = False
            elif b == 4:
                self._arm(not self.line and not self.dirty)
            elif b in (8, 127):
                if self.line:
                    del self.line[-1]
            elif b in (3, 21):
                self.line.clear()
                self.dirty = False
            elif b < 32:
                self.dirty = True
            else:
                self.line.append(b)

    def on_output(self, data: bytes) -> None:
        if self.armed_at is not None:
            self.out += data
            if len(self.out) > 4096:
                del self.out[:-4096]

    def shell_gone(self, last_output: float) -> bool:
        if self.armed_at is None:
            return False
        now = time.monotonic()
        if now - self.armed_at < self.QUIET or now - last_output < self.QUIET:
            return False
        tail = ANSI_RE.sub(b"", bytes(self.out)).strip()
        return tail.endswith(b"exit") or tail.endswith(b"logout")


# tmux 客户端退出时：先离开备用屏幕（\e[?1049l），再打印 [detached (from session x)] / [exited] 等
TMUX_END_RE = re.compile(rb"\x1b\[\?1049l(?:(?!\x1b\[\?1049h).){0,400}?"
                         rb"\[(detached[^\]\r\n]*|exited|server exited|lost tty|terminated[^\]\r\n]*)\]", re.S)
ALT_ENTER = b"\x1b[?1049h"
NOTMUX_RE = re.compile(rb"__AISH_NOTMUX__\r?\n")


def tmux_defaults() -> list[str]:
    """aish 接入时给 tmux 设置的默认选项（用户有自己的 tmux.conf 时不设置）。
    都带 -q：老版本 tmux 不认识的选项静默跳过，不会让整条命令失败。"""
    opts = [
        "set -gq mouse on",                         # 滚轮翻历史、拖选复制（经 OSC 52 进本地剪贴板）
        "set -gq history-limit 100000",
        "set -sq escape-time 10",                   # 3.4 默认 500ms，会让 Claude 里按 Esc 卡一下
        "set -gq default-terminal $D",              # tmux-256color（没有则 screen-256color）
        # 和网页 WebShell 一致用 bash --norc，并保留平台导出的 PS1（带 pod 名）。tmux 经 `$SHELL -c` 启动
        # default-command，而非交互 bash 会去掉 PS1，所以先把它另存为 AISH_PS1 再恢复。
        'setenv -g AISH_PS1 "$PS1"',
        """set -gq default-command '[ -n "$AISH_PS1" ] && export PS1="$AISH_PS1"; exec bash --norc'""",
    ]
    if os.environ.get("COLORTERM", "").lower() in ("truecolor", "24bit"):  # 本地终端支持真彩色
        opts += ["set -sq 'terminal-features[90]' 'xterm-256color:RGB'", "setenv -g COLORTERM truecolor"]
    return opts


def tmux_attach_line(session: str) -> str:
    """输入到远端 shell 的一行：接入（或新建）tmux 会话。
    -A 已存在就接入；-D 踢掉其它（如上次断线残留的）客户端；-u 强制 UTF-8。
    选项放在 new-session 之前设置，新建会话的第一个窗口也能生效；接入已有会话时同样会更新选项。
    tmux 正常结束（detach / 被踢 / 会话结束）后 `&& exit` 让这个 shell 也退出，不留游离 shell；
    tmux 启动失败则留在 shell 里，能看到报错。行首空格：不进 bash 历史（HISTCONTROL=ignorespace 时）。
    AISH_TMUX_SOCKET：使用独立的 tmux socket（tmux -L，测试用）；AISH_TMUX_DEFAULTS=0：不设置默认选项。"""
    s = shlex.quote(session)
    sock = os.environ.get("AISH_TMUX_SOCKET")
    tmux = "tmux -u" + (f" -L {shlex.quote(sock)}" if sock else "")
    plain = f"TERM=$T {tmux} new-session -A -D -s {s}"
    if os.environ.get("AISH_TMUX_DEFAULTS", "1") == "0":
        run = plain
    else:
        chain = " \\; ".join(["start-server"] + tmux_defaults() + [f"new-session -A -D -s {s}"])
        run = (f'if [ -e ~/.tmux.conf ] || [ -e "${{XDG_CONFIG_HOME:-$HOME/.config}}/tmux/tmux.conf" ]; '
               f"then {plain}; else TERM=$T {tmux} {chain}; fi")
    return (" command -v tmux >/dev/null 2>&1 || printf '__AISH_%s__\\n' NOTMUX; "
            "T=xterm; infocmp xterm-256color >/dev/null 2>&1 && T=xterm-256color; "
            "D=screen-256color; infocmp tmux-256color >/dev/null 2>&1 && D=tmux-256color; "
            f"{run} && exit\r")


def term_size(fd: int) -> tuple[int, int]:
    try:
        s = os.get_terminal_size(fd)
        if s.columns > 0 and s.lines > 0:
            return s.columns, s.lines
    except OSError:
        pass
    return 80, 24


# =========================================================================== 交互模式

async def interactive(t: Target, jar: CookieJar, info: ShellInfo, ws, tmux: str | None,
                      initial_cmd: str | None, in_fd: int, out_fd: int) -> int:
    import termios
    import tty
    from websockets.exceptions import ConnectionClosed

    loop = asyncio.get_running_loop()
    size_fd = out_fd if os.isatty(out_fd) else in_fd
    stop: asyncio.Future = loop.create_future()

    def finish(reason: str, code: int) -> None:
        if not stop.done():
            stop.set_result((reason, code))

    esc = EscapeFilter()
    dec = codecs.getincrementaldecoder("utf-8")("replace")
    winch = asyncio.Event()
    st = {"sendq": None, "hiding": False, "tmux": bool(tmux), "watcher": None}

    def on_stdin() -> None:
        try:
            data = os.read(in_fd, 65536)
        except (BlockingIOError, InterruptedError):
            return
        except OSError as e:
            finish(f"读取本地输入失败：{e}", 1)
            return
        if not data:
            finish("本地输入已结束（EOF）", 1)
            return
        data, action = esc.feed(data)
        q = st["sendq"]
        if data and q is not None and not st["hiding"]:   # 重连中 / tmux 启动前的输入丢弃
            if st["watcher"] is not None:
                st["watcher"].on_input(data)
            s = dec.decode(data)
            if s:
                q.put_nowait(s)
        if action == "disconnect":
            finish("已断开（~.）", 0)

    async def run_conn(info: ShellInfo, ws) -> str:
        """跑一条连接，直到连接丢失（返回原因）；终局结果（detach、~. 等）直接 finish()。"""
        sendq: asyncio.Queue = asyncio.Queue()
        first_output = asyncio.Event()
        last_output = [time.monotonic()]
        watcher = None if st["tmux"] else ExitWatcher()
        st.update(sendq=sendq, watcher=watcher, hiding=st["tmux"])
        held = bytearray()
        tail = bytearray()

        def show(b: bytes) -> None:
            write_all(out_fd, b)

        def reveal(from_buf: bytes, why: str) -> None:
            st["hiding"] = False
            log(f"tmux 启动阶段结束：{why}")
            if from_buf:
                show(from_buf)

        async def reader() -> str:
            try:
                async for m in ws:
                    if not m:
                        continue
                    b = as_bytes(m)
                    last_output[0] = time.monotonic()
                    first_output.set()
                    if st["hiding"]:
                        held.extend(b)
                        i = held.find(ALT_ENTER)
                        mm = NOTMUX_RE.search(held)
                        if mm:
                            st["tmux"] = False
                            st["watcher"] = ExitWatcher()
                            reveal(bytes(held[mm.end():]), "pod 上没有 tmux")
                            note("pod 上没有 tmux，已进入普通 shell（断线不会自动重连）")
                        elif i >= 0:
                            reveal(bytes(held[i:]), "tmux 已接入")
                        continue
                    show(b)
                    if st["watcher"] is not None:
                        st["watcher"].on_output(b)
                    if st["tmux"]:
                        tail.extend(b)
                        if len(tail) > 4096:
                            del tail[:-4096]
                        mt = TMUX_END_RE.search(tail)
                        if mt:
                            what = mt.group(1).decode("utf-8", "replace")
                            if what.startswith("detached"):
                                finish(f"已从 tmux 会话「{tmux}」分离，会话仍在 pod 上运行；再次运行同一命令即可接回"
                                       "（如果不是你按的 detach，说明会话在别处被接管了）", 0)
                            elif what == "exited":
                                finish(f"tmux 会话「{tmux}」已结束", 0)
                            else:
                                finish(f"tmux 客户端已退出（{what}）", 0)
            except ConnectionClosed:
                pass
            code, reason = close_desc(ws)
            log(f"server closed: code={code} reason={reason!r}")
            return f"连接断开（close code={code}{', ' + reason if reason else ''}）"

        async def sender() -> None:
            try:
                while True:
                    await ws.send(await sendq.get())
            except ConnectionClosed:
                pass

        async def resizer() -> None:
            try:
                await asyncio.wait_for(first_output.wait(), INITIAL_RESIZE_DELAY)
            except asyncio.TimeoutError:
                pass
            last = None
            while True:
                c, r = term_size(size_fd)
                if (c, r) != last:
                    try:
                        await asyncio.to_thread(do_resize, info, jar.get(), c, r)
                        last = (c, r)
                    except AishError as e:
                        log(f"opsresize 失败：{e}")
                await winch.wait()
                winch.clear()
                await asyncio.sleep(0.05)

        async def typer() -> None:
            try:
                await asyncio.wait_for(first_output.wait(), 5.0)
            except asyncio.TimeoutError:
                pass
            await asyncio.sleep(0.2)
            if st["tmux"]:
                sendq.put_nowait(tmux_attach_line(tmux or DEFAULT_TMUX_SESSION))
                await asyncio.sleep(TMUX_START_TIMEOUT)
                if st["hiding"]:
                    st["tmux"] = False
                    st["watcher"] = ExitWatcher()
                    reveal(bytes(held), "超时")
                    note("没能进入 tmux（见上方输出），当前是普通 shell（断线不会自动重连）")
            elif initial_cmd:
                sendq.put_nowait(initial_cmd + "\r")

        async def exit_watch() -> None:
            while True:
                await asyncio.sleep(0.25)
                w = st["watcher"]
                if w is not None and w.shell_gone(last_output[0]):
                    finish("远端 shell 已退出", 0)
                    return

        aux = [asyncio.create_task(c) for c in (sender(), heartbeat(ws), resizer(), typer(), exit_watch())]
        rd, lv = asyncio.create_task(reader()), asyncio.create_task(liveness(ws))
        try:
            done, _ = await asyncio.wait({rd, lv}, return_when=asyncio.FIRST_COMPLETED)
            reason = (rd if rd in done else lv).result()
            if lv in done:
                abort_ws(ws)
            return reason
        finally:
            st.update(sendq=None, watcher=None, hiding=False)
            for x in aux + [rd, lv]:
                x.cancel()

    async def wait_or_stop(delay: float) -> bool:
        try:
            await asyncio.wait_for(asyncio.shield(stop), delay)
            return True
        except asyncio.TimeoutError:
            return False

    old_attr = termios.tcgetattr(in_fd)
    sigs = [signal.SIGTERM, signal.SIGHUP, signal.SIGINT, signal.SIGQUIT]
    cur_ws = ws
    try:
        tty.setraw(in_fd, termios.TCSANOW)
        loop.add_signal_handler(signal.SIGWINCH, winch.set)
        for s in sigs:
            loop.add_signal_handler(s, finish, f"收到信号 {signal.Signals(s).name}", 128 + int(s))
        loop.add_reader(in_fd, on_stdin)
        while not stop.done():
            conn = asyncio.create_task(run_conn(info, cur_ws))
            await asyncio.wait({conn, stop}, return_when=asyncio.FIRST_COMPLETED)
            if stop.done():
                conn.cancel()
                break
            reason = conn.result()
            if not st["tmux"]:
                finish(f"{reason}。远端没有 tmux 保护，不自动重连", 1)
                break
            # ---- tmux 模式：自动重连，接回同一个会话
            attempt = 0
            sys.stderr.write("\r\n")
            while not stop.done():
                delay = min(RECONNECT_MAX_DELAY, 2.0 ** attempt) if attempt else 1.0
                note(f"{short(reason)}；{delay:g}s 后重连（第 {attempt + 1} 次，行首 ~. 放弃）")
                if await wait_or_stop(delay):
                    break
                try:
                    c, r = term_size(size_fd)
                    info, cur_ws = await connect_shell(t, jar, c, r)
                    note("已重连，正在接回 tmux 会话…")
                    break
                except AishError as e:
                    reason = str(e)
                    attempt += 1
    finally:
        loop.remove_reader(in_fd)
        for s in sigs + [signal.SIGWINCH]:
            loop.remove_signal_handler(s)
        termios.tcsetattr(in_fd, termios.TCSADRAIN, old_attr)
        try:
            await asyncio.wait_for(cur_ws.close(), 3)
        except Exception:
            pass
    reason, code = stop.result()
    sys.stderr.write("\r\n")
    note(reason)
    return code


# =========================================================================== 非交互 --exec

async def run_exec(info: ShellInfo, ws, cmd: str, timeout: float) -> int:
    from websockets.exceptions import ConnectionClosed

    loop = asyncio.get_running_loop()
    deadline = loop.time() + timeout
    buf = bytearray()
    got = asyncio.Event()
    closed = asyncio.Event()

    async def reader() -> None:
        try:
            async for m in ws:
                buf.extend(as_bytes(m))
                got.set()
        except ConnectionClosed:
            pass
        finally:
            closed.set()
            got.set()

    async def wait_until(pred, until: float) -> bool:
        """等到 pred() 为真返回 True；连接关闭返回 False；超时抛 TimeoutError。"""
        while True:
            got.clear()
            if pred():
                return True
            if closed.is_set():
                return False
            rem = until - loop.time()
            if rem <= 0:
                raise TimeoutError
            try:
                await asyncio.wait_for(got.wait(), rem)
            except asyncio.TimeoutError:
                raise TimeoutError from None

    tag = secrets.token_hex(6)
    begin_re = re.compile(rb"__AISH_B_" + tag.encode() + rb"__\r?\n")
    end_re = re.compile(rb"__AISH_E_" + tag.encode() + rb"_(\d+)__")
    # 标记由 printf 拼出来，回显的命令行里不会出现完整标记；用 eval 包住命令，$? 即命令的退出码。
    line = (f"printf '__AISH_%s_%s__\\n' B {tag}; eval {shlex.quote(cmd)}; "
            f"printf '__AISH_%s_%s_%d__\\n' E {tag} $?\r")

    rt = asyncio.create_task(reader())
    hb = asyncio.create_task(heartbeat(ws))
    try:
        try:  # 等提示符出现（首个输出且安静 0.3s），再输入命令；等不到也照发（tty 会缓冲）
            await wait_until(lambda: len(buf) > 0, min(deadline, loop.time() + 5))
            while True:
                n = len(buf)
                await asyncio.sleep(0.3)
                if len(buf) == n or closed.is_set():
                    break
        except TimeoutError:
            pass
        if closed.is_set():
            raise AishError(f"远端在执行命令前关闭了连接（close code={close_desc(ws)[0]}）。", 255)
        await ws.send(line)

        mb: list = [None]
        me: list = [None]

        def done() -> bool:
            if mb[0] is None:
                mb[0] = begin_re.search(buf)
            if mb[0] is not None:
                me[0] = end_re.search(buf, mb[0].end())
            return me[0] is not None

        try:
            ok = await wait_until(done, deadline)
        except TimeoutError:
            ok = None
        start = mb[0].end() if mb[0] is not None else None
        if ok:
            out = bytes(buf[start:me[0].start()])
            rc = int(me[0].group(1))
        else:
            out = bytes(buf[start:]) if start is not None else b""
            if ok is None:
                note(f"命令在 {timeout:g}s 内没有结束（--timeout），发送 Ctrl-C 后退出远端 shell。")
                try:
                    await ws.send("\x03")
                    await asyncio.sleep(0.3)
                except ConnectionClosed:
                    pass
                rc = 124
            else:
                note(f"远端连接在命令结束前关闭（close code={close_desc(ws)[0]}）。")
                rc = 255
        sys.stdout.buffer.write(out.replace(b"\r\n", b"\n"))
        sys.stdout.buffer.flush()
        if not closed.is_set():
            # 实测：远端 shell 退出后网关并不关闭 WebSocket。bash 退出时会自己打印 exit
            # （加上回显共两次），看到即可认为 shell 已退出；非 bash 最多等 3s。
            mark, t_exit = len(buf), loop.time()
            gone = False
            try:
                await ws.send("exit\r")
                gone = await wait_until(lambda: bytes(buf[mark:]).count(b"exit") >= 2, loop.time() + 3)
            except (ConnectionClosed, TimeoutError):
                pass
            log(f"exit 后 {loop.time() - t_exit:.2f}s，shell 已退出={gone}，服务端已关闭={closed.is_set()}")
        return rc
    finally:
        hb.cancel()
        try:
            await asyncio.wait_for(ws.close(), 3)
        except Exception:
            pass
        rt.cancel()


# =========================================================================== 子命令

def cmd_add(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="aish add", description="保存一台机器")
    p.add_argument("name")
    p.add_argument("url", help="平台 web-shell 页面 URL")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--tmux", metavar="SESSION", default=DEFAULT_TMUX_SESSION,
                   help=f"接入时使用的 tmux 会话名（默认 {DEFAULT_TMUX_SESSION}）")
    g.add_argument("--no-tmux", action="store_true", help="接入普通 shell，不用 tmux（断线不自动重连）")
    a = p.parse_args(argv)
    if a.name in SUBCOMMANDS or a.name.startswith(("-", "http:", "https:")):
        raise AishError(f"机器名不能是 {a.name!r}")
    t = target_from(a.url)
    hosts = load_hosts()
    hosts[a.name] = {"url": a.url, "tmux": None if a.no_tmux else a.tmux}
    save_hosts(hosts)
    mode = "普通 shell" if a.no_tmux else f"tmux 会话 {a.tmux}"
    print(f"已保存 {a.name} → pod {t.pod}（{mode}）。用法：aish {a.name}")
    return 0


def cmd_ls(argv: list[str]) -> int:
    hosts = load_hosts()
    if not hosts:
        print(f"还没有保存的机器。用 aish add <名字> '<web-shell URL>' 添加（保存在 {hosts_path()}）")
        return 0
    w = max(len(n) for n in hosts)
    for n, h in sorted(hosts.items()):
        try:
            t = target_from(h.get("url"))
            desc = f"pod={t.pod} run={t.run} container={t.container}"
        except AishError as e:
            desc = f"（URL 无效：{e}）"
        print(f"{n:<{w}}  {('tmux:' + h['tmux']) if h.get('tmux') else '普通shell':<12}  {desc}")
    return 0


def cmd_rm(argv: list[str]) -> int:
    if len(argv) != 1:
        raise AishError("用法：aish rm <名字>")
    hosts = load_hosts()
    if hosts.pop(argv[0], None) is None:
        raise AishError(f"没有名为 {argv[0]!r} 的机器（aish ls 查看）")
    save_hosts(hosts)
    print(f"已删除 {argv[0]}")
    return 0


def cmd_login(argv: list[str]) -> int:
    base = (os.environ.get("AIS_BASE_URL") or DEFAULT_BASE).rstrip("/")
    jar = CookieJar(base, allow_browser=True)
    v = jar.from_browser(force=True)
    if not v:
        raise AishError(f"浏览器里没有找到 {jar.host} 的 ais_token。请先在 Chrome 里登录 AI Studio（{base}）。")
    print(f"cookie 已更新：{jar.path}")
    return 0


# =========================================================================== main

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="aish", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="AI Studio WebShell 终端客户端（效果类似 ssh -t）。",
        epilog="子命令：aish add <名字> <URL> [--tmux S|--no-tmux] | aish ls | aish rm <名字> | aish login\n"
               "aish <目标> -- <命令...>  连上后自动输入该命令（普通 shell 模式）。\n"
               "交互模式下行首 ~. 断开连接。")
    p.add_argument("target", nargs="?", help="保存的机器名，或平台 web-shell 页面 URL")
    p.add_argument("--project", help="projectId")
    p.add_argument("--experiment", help="experimentId")
    p.add_argument("--run", help="runId")
    p.add_argument("--pod", help="podName")
    p.add_argument("--container", help="containerName（默认 main）")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--tmux", metavar="SESSION", help="接入 pod 上的 tmux 会话（断线自动重连）")
    g.add_argument("--no-tmux", action="store_true", help="不用 tmux，接入普通 shell")
    p.add_argument("--exec", dest="exec_cmd", metavar="CMD", help="非交互执行命令并按远端退出码退出")
    p.add_argument("--timeout", type=float, default=30.0, help="--exec 超时秒数（默认 30）")
    p.add_argument("--no-browser-cookie", action="store_true", help="不从浏览器读取 cookie")
    p.add_argument("-v", "--verbose", action="store_true", help="调试输出（凭据会打码）")
    return p


def main(argv: list[str]) -> int:
    global VERBOSE
    if "-v" in argv or "--verbose" in argv:
        VERBOSE = True
    if argv and argv[0] in SUBCOMMANDS:
        sub, rest = argv[0], [x for x in argv[1:] if x not in ("-v", "--verbose")]
        if sub == "help":
            build_parser().print_help()
            return 0
        return {"add": cmd_add, "ls": cmd_ls, "rm": cmd_rm, "login": cmd_login}[sub](rest)

    initial: list[str] | None = None
    if "--" in argv:
        i = argv.index("--")
        argv, initial = argv[:i], argv[i + 1:]
    a = build_parser().parse_args(argv)
    if initial is not None and a.exec_cmd is not None:
        raise AishError("--exec 和 -- <命令> 不能同时使用。")
    if initial is not None and not initial:
        raise AishError("-- 后面需要命令。")
    if initial is not None and a.tmux:
        raise AishError("--tmux 和 -- <命令> 不能同时使用。")

    overrides = {k: getattr(a, k) for k in ("project", "experiment", "run", "pod", "container")}
    tmux = a.tmux
    if a.target and not a.target.startswith(("http://", "https://")):
        hosts = load_hosts()
        if a.target not in hosts:
            raise AishError(f"未知的机器名 {a.target!r}（aish ls 查看，aish add 添加）")
        h = hosts[a.target]
        t = target_from(h.get("url"), overrides)
        if not a.tmux and not a.no_tmux and initial is None:
            tmux = h.get("tmux")
    else:
        t = target_from(a.target, overrides)

    allow_browser = not (a.no_browser_cookie or os.environ.get("AISH_NO_BROWSER_COOKIE"))
    jar = CookieJar(t.base, allow_browser)
    jar.get()

    in_fd, out_fd = sys.stdin.fileno(), sys.stdout.fileno()
    if a.exec_cmd is None and not os.isatty(in_fd):
        raise AishError("stdin 不是终端，无法进入交互模式；非交互请用 --exec '<命令>'。")

    loop = asyncio.SelectorEventLoop(selectors.SelectSelector())  # select() 对 tty 最可靠
    asyncio.set_event_loop(loop)
    try:
        if a.exec_cmd is not None:
            cols, rows = term_size(out_fd) if os.isatty(out_fd) else (200, 50)
            info, ws = loop.run_until_complete(connect_shell(t, jar, cols, rows))
            return loop.run_until_complete(run_exec(info, ws, a.exec_cmd, a.timeout))
        cols, rows = term_size(out_fd if os.isatty(out_fd) else in_fd)
        info, ws = loop.run_until_complete(connect_shell(t, jar, cols, rows))
        cmd = " ".join(initial) if initial else None
        return loop.run_until_complete(interactive(t, jar, info, ws, tmux, cmd, in_fd, out_fd))
    finally:
        loop.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except AishError as e:
        sys.stderr.write("aish: " + REDACT(e) + "\n")
        sys.exit(e.code)
    except KeyboardInterrupt:
        sys.stderr.write("aish: 已中断\n")
        sys.exit(130)
    except Exception as e:  # 兜底：不打 traceback，避免把 URL/凭据带出来
        sys.stderr.write(f"aish: 内部错误 {type(e).__name__}: {REDACT(e)}\n")
        sys.exit(1)
